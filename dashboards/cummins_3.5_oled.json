{
  "name": "Cummins 6BTA 3.5-inch OLED",
  "target_firmware": "firmware/cummins_6bta",
  "display": {
    "type": "SSD1351",
    "width": 128,
    "height": 96,
    "color_depth": 16
  },
  "themes": {
    "day": {
      "background": "#000000",
      "text": "#FFFFFF",
      "normal": "#00FF00",
      "warning": "#FFFF00",
      "critical": "#FF0000"
    }
  },
  "current_theme": "day",
  "backlight": {
    "dim_after_ms": 30000
  },
  "alerts": {
    "banner_height": 10,
    "buzzer_freq_hz": 2730,
    "beep_duration_ms": 150
  },
  "layout": "compact",
  "gauges": [
    {
      "id": "rpm",
      "type": "digital_readout",
      "label": "RPM",
      "data_source": "engine.rpm",
      "position": { "x": 0, "y": 8 },
      "font": "large",
      "format": "%.0f",
      "color_source": "threshold",
      "thresholds": {
        "yellow_rpm": 2600,
        "red_rpm": 2800
      }
    },
    {
      "id": "coolant_temp",
      "type": "digital_readout",
      "label": "TEMP",
      "data_source": "engine.coolant_temp_c",
      "position": { "x": 0, "y": 28 },
      "font": "medium",
      "format": "%.0fC",
      "color_source": "threshold",
      "thresholds": {
        "yellow_temp": 96,
        "red_temp": 104
      }
    },
    {
      "id": "oil_pressure",
      "type": "digital_readout",
      "label": "OIL",
      "data_source": "engine.oil_pressure_bar",
      "position": { "x": 0, "y": 44 },
      "font": "medium",
      "format": "%.1fb",
      "color_source": "threshold"
    },
    {
      "id": "oil_temp",
      "type": "digital_readout",
      "label": "OILT",
      "data_source": "engine.oil_temp_c",
      "position": { "x": 0, "y": 60 },
      "font": "medium",
      "format": "%.0fC"
    },
    {
      "id": "fuel",
      "type": "digital_readout",
      "label": "FUEL",
      "data_source": "engine.fuel_level_pct",
      "position": { "x": 0, "y": 76 },
      "font": "medium",
      "format": "%.0f%%"
    },
    {
      "id": "volts",
      "type": "digital_readout",
      "label": "BAT",
      "data_source": "engine.battery_volts",
      "position": { "x": 0, "y": 88 },
      "font": "small",
      "format": "%.1fV"
    }
  ],
  "readouts": [],
  "status_indicators": []
}
